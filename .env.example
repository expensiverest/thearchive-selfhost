# The Archive self-host configuration.
#
# install.sh copies this template to .env, fills the required values and sets mode 600.
# Never commit the real .env. Never put real secrets in this example file.

# Release tag to run, e.g. v0.1.0. "latest" tracks the newest published images.
ARCHIVE_VERSION=latest

# Where the data lives on the host (db/, storage/, run/ are created under it).
ARCHIVE_ROOT=./data

# Owner of the data directory; must match the host user running Docker (usually 1000).
HOST_UID=1000
HOST_GID=1000

# --- required, generated by install.sh (openssl rand) -----------------------------------------
POSTGRES_PASSWORD=

# --- network ----------------------------------------------------------------------------------
# Where the API port is published. Default 127.0.0.1 (host-local only; put a reverse proxy or
# tunnel in front for public access). Set to the host's LAN/Tailscale address to reach it directly.
API_BIND_ADDR=127.0.0.1

# Public base URL used in invitation links. Set this once you have a public HTTPS hostname, and
# point it at the same hostname your tunnel/proxy serves.
PUBLIC_BASE_URL=

# --- optional upload tuning (defaults match the capacity note) --------------------------------
# MAX_CHUNK_BYTES=8388608
# MAX_UPLOAD_BYTES=2147483648
# STAGING_QUOTA_BYTES=10737418240
# UPLOAD_TTL_MS=86400000
# DEFAULT_USER_QUOTA_BYTES=0        # 0 = unlimited
# MIN_APP_VERSION=0.0.0             # tell older clients to update (semver)

# --- optional outbound email for invitations --------------------------------------------------
# Without SMTP_URL the server uses the log transport (invite links appear in the API log).
# SMTP_URL=smtp://user:password@smtp.example.com:587       # STARTTLS
# SMTP_URL=smtps://user:password@smtp.example.com:465      # implicit TLS
# MAIL_FROM must be set whenever SMTP_URL is set.
SMTP_URL=
MAIL_FROM=

# --- optional automatic HTTPS with the bundled Caddy (compose.caddy.yaml) ----------------------
# Set DOMAIN to the hostname clients use; Caddy obtains and renews a certificate automatically.
# Requires ports 80 and 443 reachable from the internet and a DNS record for DOMAIN.
# DOMAIN=
# ACME_EMAIL=
